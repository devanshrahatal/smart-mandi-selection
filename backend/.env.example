# ==============================================================
# Smart Mandi Selection — Backend Environment Variables
# Copy this file to .env and fill in real values.
# ==============================================================

# --- App ---
APP_NAME="Smart Mandi Selection API"
APP_VERSION="0.1.0"
DEBUG=true

# --- Database (MySQL) ---
# Format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/smart_mandi"

# --- Redis ---
# Format: redis://[:password]@host:port/db
REDIS_URL="redis://localhost:6379/0"

# --- JWT Auth (admin dashboard only) ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="change-me-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Agmarknet API (data.gov.in) ---
# Get your API key at: https://data.gov.in/user/register
AGMARKNET_API_KEY=""
AGMARKNET_BASE_URL="https://api.data.gov.in/resource"

# --- Google Maps Distance Matrix API ---
# Get your API key at: https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=""

# --- Twilio WhatsApp Sandbox ---
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# --- Scheduler ---
PRICE_REFRESH_INTERVAL_HOURS=6

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
